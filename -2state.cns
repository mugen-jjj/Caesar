fvar(13) = 1

;ヒット数カウント
[State -2, launcher]
type = VarAdd
triggerall = !(stateno=[3000,3499])
trigger1 = projhit = 1
fvar(13) = 0.2

;加重加算
[State -2, assault]
type = VarAdd
triggerall = movehit = 1
trigger1 = var(8) = 1
fvar(13) = 3
[State -2, upper_enemy_air]

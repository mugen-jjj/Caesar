trigger1 = stateno = 221
fvar(13) = 2

[State -2,ヒット数初期化]
type = VarSet
triggerall = fvar(13) != 0
trigger1 = p2MoveType != H
trigger1 = NumTarget = 0
fvar(13) = 0

[State -2,浮き補正]
type = varset

[State -1, stop];
Type = Stopsnd
trigger1 = stateno != 2300
channel = 3

[State 200, stop]
type = removeexplod
trigger1 = NumExplod(1350)
trigger1 = stateno != 1300
id = 1350

[State 0, end]
type = removeexplod
trigger1 = stateno != [3000,3099]
id = 7001

[State 0, end]
type = removeexplod
triggerall = NumExplod(7700)
trigger1 = movecontact
trigger2 = !var(8)
id = 7700
ignorehitpause = 1


fVar(20) = 0.25*(fvar(13))

[State -2,浮き補正リセット]
type = varset
triggerall = p2MoveType != H
trigger1 = fvar(13) = 0
fVar(20) = 0

[State -2,壁バウンド初期化]
type = VarSet
triggerall = var(9) != 0
trigger1 = p2MoveType != H
trigger1 = NumTarget = 0
var(9) = 0

[State -2,コンボ補正3]
type = VarSet
trigger1 = 1
fVar(10) = ifelse((1.0-(fvar(13)*0.05))<=0,0.1,(1.0-(fvar(13)*0.05)))
[State -2,コンボ補正3]
type = VarSet
triggerall = fvar(10) < 0.5
trigger1 = (stateno=[3000,3499])
fVar(10) = 0.5

[State -2,アサルトフラグ]
type = varset
trigger1 = var(8) > 0
trigger1 = movehit = 1
var(8) = 10

[State -2,アサルトフラグ]
type = varset
trigger1 = (statetype != A && stateno != 52 && stateno != 700)
trigger2 = movetype = H
var(8) = 0

[State -3, ExShadow]
